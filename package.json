{
  "name": "dispar-flux",
  "version": "0.0.1",
  "private": true,
  "description": "Dispar Flux - Plataforma Web de Atendimento Multiatendente e Mensageria WhatsApp (Edição Comunitária AGPLv3)",
  "type": "module",
  "bin": {
    "dispar-cli": "./bin/dispar-cli.js"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "tsx --test packages/*/tests/**/*.test.ts && node --test tests/gate-1.0.test.mjs",
    "test:packages": "tsx --test packages/*/tests/**/*.test.ts",
    "test:gate": "node --test tests/gate-1.0.test.mjs",
    "test:gate:phase0": "node --test tests/phase0-gate.test.mjs",
    "test:all": "tsx --test packages/*/tests/**/*.test.ts && node --test tests/gate-1.0.test.mjs",
    "typecheck": "tsc --build",
    "build": "tsc --build"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  }
}
