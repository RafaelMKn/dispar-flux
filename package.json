{
  "name": "dispar-flux",
  "version": "0.3.0",
  "description": "App desktop open-source para gestao de campanhas no WhatsApp (Baileys embutido).",
  "author": {
    "name": "RafaelMKn",
    "url": "https://github.com/RafaelMKn"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelMKn/dispar-flux.git"
  },
  "homepage": "https://github.com/RafaelMKn/dispar-flux",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "release": "electron-vite build && electron-builder --win --config electron-builder.yml --publish always"
  },
  "dependencies": {
    "baileys": "^6.7.23",
    "drizzle-orm": "^0.38.3",
    "electron-updater": "^6.8.9",
    "libphonenumber-js": "^1.13.9",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
